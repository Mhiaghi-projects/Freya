# Variables de entorno de Freya.
# Copiar a .env y ajustar. NUNCA poner valores reales en este fichero.

# --- Global ---------------------------------------------------------------
FREYA_ENVIRONMENT=dev
FREYA_LOG_LEVEL=info

# Poner en false SOLO durante el bootstrap de la Fase 1.
# La Fase 2 lo devuelve a true y el token de bootstrap queda inválido.
FREYA_AUTH_ENABLED=true

# --- URLs de la malla -----------------------------------------------------
FREYA_AUTH_URL=https://freya-auth:8002
FREYA_GESTOR_DB_URL=https://freya-gestor-db:8001
FREYA_SECRETS_URL=https://freya-secrets:8003
FREYA_STORAGE_URL=https://freya-storage:8004

# --- database (sólo lo lee gestor-db) -------------------------------------
POSTGRES_DB=freya
POSTGRES_USER=freya
# La contraseña va en infra/secrets/database/postgres_password, no aquí.

# --- Ficheros de secretos montados ----------------------------------------
# infra/secrets/gestor-db/bootstrap_token   token estático de la Fase 1
# infra/secrets/gestor-db/postgres_password contraseña de PostgreSQL
# infra/secrets/<servicio>/client_secret    credencial de service account
# infra/secrets/secrets/master_key          master key de envelope encryption

# --- frontend -------------------------------------------------------------
FREYA_PUBLIC_URL=https://localhost
FREYA_RATE_LIMIT_PER_MINUTE=120

# --- GitHub (docs/DECISIONS.md, migración de git/project-manager/cicd) ----
# services/github-runner/ -- runner autoalojado. El PAT va en
# infra/secrets/github-runner/github_pat, no aquí (ver README ahí).
GITHUB_RUNNER_URL=https://github.com/<owner>[/<repo>]
GITHUB_RUNNER_NAME=freya-local
GITHUB_RUNNER_LABELS=self-hosted,freya

# gamification/ -- sincronización de XP desde GitHub Issues, apagada hasta
# que esto tenga valores reales (ver gamification/app/domain/
# github_task_sync.py). El PAT va en infra/secrets/gamification/github_pat
# (puede ser el mismo que el del runner).
GITHUB_TASK_SYNC=false
GITHUB_OWNER=
GITHUB_GAMIFICATION_REPOS=
GITHUB_DEFAULT_USER_ID=
