# Los scripts de shell se montan dentro de contenedores Linux desde un host
# Windows. Si Git los convierte a CRLF, bash falla con
# "bad interpreter: /usr/bin/env bash^M". Se fuerza LF siempre.
*.sh            text eol=lf
*.py            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
.env.example    text eol=lf

# PowerShell se queda con finales de linea de Windows.
*.ps1           text eol=crlf
*.psm1          text eol=crlf

# Documentacion: normalizada, sin preferencia fuerte.
*.md            text
*.json          text

# Binarios: nunca tocar.
*.png           binary
*.jpg           binary
*.gz            binary
*.zip           binary
*.crt           binary
*.key           binary
